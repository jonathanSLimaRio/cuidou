{
  "name": "cuidou-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test e2e/api-contracts.spec.ts",
    "test:e2e:smoke": "playwright test e2e/critical-flows.spec.ts",
    "test:web": "npm run lint && npm run typecheck && npm test",
    "test:mobile:lint": "npm --prefix CuidouApp run lint",
    "test:mobile:typecheck": "npx tsc --noEmit -p CuidouApp/tsconfig.json",
    "test:mobile": "npm run test:mobile:lint && npm run test:mobile:typecheck",
    "check:versions": "node scripts/check_versions.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check:health": "node scripts/check_health.mjs",
    "check:release": "node scripts/check_release.mjs",
    "postinstall": "prisma generate",
    "predeploy": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "migrate:blob-to-wordpress": "tsx scripts/migrate_blob_to_wordpress.ts",
    "design:media": "tsx scripts/generate_and_upload_design_media.ts",
    "super-admin": "tsx scripts/create_super_admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/render": "^2.0.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ably": "^2.21.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.575.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.18.0",
    "prisma": "^7.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "6.1.3",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "flatted": "3.4.2",
    "minimatch@<=3.1.3": "3.1.4",
    "minimatch@>=9.0.0 <9.0.7": "9.0.9",
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3"
  }
}
