{
  "name": "cuidou-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test e2e/api-contracts.spec.ts",
    "test:e2e:smoke": "playwright test e2e/critical-flows.spec.ts",
    "test:e2e:auth": "playwright test e2e/sprint4-authenticated.spec.ts e2e/mobile-auth-contracts.spec.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:expo-doctor": "npm --prefix CuidouApp run doctor",
    "fixtures:e2e": "tsx scripts/e2e-fixtures.ts",
    "fixtures:e2e:cleanup": "cross-env E2E_FIXTURE_ACTION=cleanup tsx scripts/e2e-fixtures.ts",
    "test:web": "npm run lint && npm run typecheck && npm test",
    "test:mobile:lint": "npm --prefix CuidouApp run lint",
    "test:mobile:typecheck": "npx tsc --noEmit -p CuidouApp/tsconfig.json",
    "test:mobile": "npm run test:mobile:lint && npm run test:mobile:typecheck",
    "check:versions": "node scripts/check_versions.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check:health": "node scripts/check_health.mjs",
    "check:release": "node scripts/check_release.mjs",
    "release:staging": "node scripts/release_staging.mjs",
    "postinstall": "prisma generate",
    "predeploy": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "migrate:blob-to-wordpress": "tsx scripts/migrate_blob_to_wordpress.ts",
    "design:media": "tsx scripts/generate_and_upload_design_media.ts",
    "super-admin": "tsx scripts/create_super_admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "10.69.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ably": "^2.26.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.575.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "flatted": "3.4.2",
    "minimatch@<=3.1.3": "3.1.4",
    "minimatch@>=9.0.0 <9.0.7": "9.0.9",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "minimatch@3.1.4": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "@eslint/config-array": {
      "brace-expansion": "1.1.18"
    },
    "@eslint/eslintrc": {
      "brace-expansion": "1.1.18"
    },
    "eslint": {
      "brace-expansion": "1.1.18"
    },
    "eslint-config-next": {
      "brace-expansion": "1.1.18"
    },
    "eslint-plugin-import": {
      "brace-expansion": "1.1.18"
    },
    "typescript-eslint": {
      "brace-expansion": "2.1.4"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "2.1.4"
    },
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
}
