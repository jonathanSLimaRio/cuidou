# =============================================================================
# Cuidou — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env.local e preencha com seus valores reais.
# Em produção/preview, use `vercel env pull .env.local` para sincronizar.
# NUNCA faça commit do .env.local com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# URL pública do app (sem trailing slash)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Em produção: NEXT_PUBLIC_APP_URL=https://www.cuidou.app

# Host/porta do servidor Next.js em desenvolvimento
HOST=localhost
PORT=3000

# -----------------------------------------------------------------------------
# Autenticação (NextAuth v5 / Auth.js)
# Gere o AUTH_SECRET com: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=your-random-secret-here-min-32-chars
APP_VERSION=local
RELEASE_ENV=development

# OAuth — Google (opcional, mas recomendado)
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Ably Realtime (obrigatorio em producao para o chat web)
ABLY_API_KEY=your-ably-api-key

# Rate limit distribuído (obrigatório em produção)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL / Prisma)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Em produção usamos Prisma Postgres (db.prisma.io) via Vercel.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@db.prisma.io:5432/postgres?sslmode=require
POSTGRES_URL=postgres://user:password@db.prisma.io:5432/postgres?sslmode=require
PRISMA_DATABASE_URL=postgres://user:password@db.prisma.io:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# WordPress (armazenamento de mídia, documentos e GraphQL)
# -----------------------------------------------------------------------------
WORDPRESS_URL=https://seu-wordpress.exemplo.com
WORDPRESS_GRAPHQL_URL=https://seu-wordpress.exemplo.com/graphql
NEXT_PUBLIC_WORDPRESS_API_URL=https://seu-wordpress.exemplo.com
# Hostname exposto ao Next.js para otimização de imagens
# (deve corresponder ao hostname do WORDPRESS_URL, sem protocolo)
NEXT_PUBLIC_WORDPRESS_API_HOSTNAME=seu-wordpress.exemplo.com
WP_USER=seu-usuario-wordpress
WP_APP_PASS=sua-senha-de-aplicacao-wordpress

# -----------------------------------------------------------------------------
# Email (Resend — https://resend.com)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@cuidou.app

# -----------------------------------------------------------------------------
# Mobile Expo (consulte CuidouApp/README.md)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
MOBILE_GOOGLE_CLIENT_IDS=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_RELEASE=cuidou-mobile@1.0.0

# -----------------------------------------------------------------------------
# Admin
# Bootstrap do super admin — usado por `yarn super-admin`.
# A senha é obrigatória apenas na primeira execução (ou em --reset-password).
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@cuidou.app
SUPER_ADMIN_PASSWORD=change-me-min-12-chars
SUPER_ADMIN_NAME=Super Admin

# -----------------------------------------------------------------------------
# Referências locais legadas (somente leitura; novos uploads exigem WordPress)
# -----------------------------------------------------------------------------
LOCAL_UPLOAD_DIR=./uploads
